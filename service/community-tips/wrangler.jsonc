{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subvibe-community-tips",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tips.nimanou.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "subvibe-community-tips", "database_id": "69b21d12-3e76-4052-9134-33a3a044b7fa" }
  ],
  // Per-address limits (the key is a salted hash): uploads and reports, and lookups.
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "4102", "simple": { "limit": 240, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
